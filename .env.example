# Copie para .env e preencha localmente. Nunca publique sua chave.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Por padrão, só o PDF fictício de examples/ pode ser enviado à API.
ALLOW_PRIVATE_BOOK_TO_GROQ=false
RPG_DB_PATH=data/assistant.sqlite3
RPG_VECTOR_PATH=data/chroma
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Corte opcional; deixe vazio até calibrar com avaliações do seu material.
MAX_VECTOR_DISTANCE=
# Reranker local opcional. Primeiro uso baixa o modelo; prepare pelo CLI.
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_CANDIDATES=10
RETRIEVAL_CANDIDATE_LIMIT=30
MAX_CHUNKS_PER_PAGE=2
# Consulta pode pesquisar e ler páginas antes de responder.
# Cada chamada ao modelo conta no limite diário, incluindo as de pesquisa.
CONSULT_TOOLS_ENABLED=true
CONSULT_MAX_MODEL_CALLS=4
CONSULT_MAX_TOOL_CALLS=4
CONSULT_CONTEXT_CHARS=16000
MAX_CALLS_PER_DAY=20
# Inclui tokens de raciocínio; respostas pedidas pelo prompt continuam breves.
MAX_OUTPUT_TOKENS=2048
GROQ_TIMEOUT_SECONDS=30
# GPT-OSS: low, medium ou high. Medium favoreceu comparações na calibração.
# Aumentar raciocínio não garante fidelidade; compare resultados e uso.
GROQ_REASONING_EFFORT=medium
# Preços em USD por 1 milhão de tokens para o modelo escolhido (opcionais).
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=

# Chat de ficha: até duas gerações (proposta + uma correção quando inválida).
# Este limite de saída inclui raciocínio, como MAX_OUTPUT_TOKENS.
SHEET_MAX_OUTPUT_TOKENS=4096
# Entrada + saída estimadas; adequado à cota observada de 8.000 tokens/minuto.
SHEET_REQUEST_TOKEN_BUDGET=7800
# A ficha usa seleção estruturada; cálculos, descrições e resumo são locais.
SHEET_REASONING_EFFORT=low
# Caminho local do formulário compatível; não publique o PDF no repositório.
SHEET_PDF_TEMPLATE=""
