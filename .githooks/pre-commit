#!/bin/sh
# Habilite com: git config core.hooksPath .githooks
if [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe scripts/check_publication.py --staged
elif [ -x .venv/bin/python ]; then
    exec .venv/bin/python scripts/check_publication.py --staged
else
    exec python scripts/check_publication.py --staged
fi
